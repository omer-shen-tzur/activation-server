# Copy to .env and replace every placeholder. Never commit .env.

# Postgres connection string used by the app (psycopg 3 format).
# 127.0.0.1, not localhost: compose publishes Postgres on IPv4 loopback only,
# and on Windows localhost may resolve to ::1 first (or reach a local Postgres install).
DATABASE_URL=postgresql://activation:change-me@127.0.0.1:5432/activations
# Database the tests use. They truncate its tables, so it must differ from DATABASE_URL's.
# The name activations_test is fixed by db/init/01_create_test_db.sql; same user and password as above.
TEST_DATABASE_URL=postgresql://activation:change-me@127.0.0.1:5432/activations_test
# Max connections in the app's psycopg connection pool.
DB_POOL_SIZE=10

# Credentials the Postgres container is initialised with (must match DATABASE_URL and TEST_DATABASE_URL).
POSTGRES_USER=activation
# Password for POSTGRES_USER.
POSTGRES_PASSWORD=change-me
# Database created on first container start.
POSTGRES_DB=activations

# Root secret for per-device keys: device_key = HMAC-SHA256(MASTER_SECRET, device_id). Use a long random value.
MASTER_SECRET=replace-with-a-long-random-string

# HTTP Basic auth username for the dashboard and /api/v1/stats.
DASHBOARD_USER=admin
# HTTP Basic auth password for the dashboard and /api/v1/stats.
DASHBOARD_PASSWORD=change-me-too

# Runtime environment: development or production. Backdating is refused when production.
ENV=development
# Dev-only: lets the simulator backdate activations to build history. Keep false unless simulating.
ALLOW_BACKDATING=false

# Activation requests allowed per client IP per minute (in-memory token bucket).
RATE_LIMIT_PER_MINUTE=60
